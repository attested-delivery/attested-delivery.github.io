{
  "name": "attested-delivery-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site for attested-delivery — the org GitHub Pages root (attested-delivery.github.io). Separate from the Starlight docs served at /docs/.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,js,mjs,css,json,md}\"",
    "lint:format": "prettier --check \"**/*.{astro,js,mjs,css,json,md}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint": "pnpm run lint:format && pnpm run lint:md"
  },
  "dependencies": {
    "astro": "7.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "js-yaml@<4.2.0": ">=4.2.0",
      "markdown-it@<14.2.0": ">=14.2.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  }
}
