---
// Giscus — live comments backed by GitHub Discussions on attested-delivery/.github
// (the same repo that backs the org-level discussions). Real IDs, no placeholders.
// Requires the giscus GitHub App to be installed on attested-delivery/.github;
// until then the widget shows a "not installed" notice.
//
// Loaded dynamically so the giscus theme can follow the site's light/dark toggle.
const repo = 'attested-delivery/.github';
const repoId = 'R_kgDOS-WGuw';
const category = 'General';
const categoryId = 'DIC_kwDOS-WGu84C_axy';
const mapping = 'pathname';
---

<div class="giscus" id="giscus-thread" data-giscus></div>

<script is:inline define:vars={{ repo, repoId, category, categoryId, mapping }}>
  (() => {
    function giscusTheme() {
      return document.documentElement.dataset.theme === 'light' ? 'light' : 'noborder_dark';
    }

    function loadGiscus() {
      const container = document.getElementById('giscus-thread');
      if (!container) return;
      container.innerHTML = '';
      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.async = true;
      s.crossOrigin = 'anonymous';
      const attrs = {
        'data-repo': repo,
        'data-repo-id': repoId,
        'data-category': category,
        'data-category-id': categoryId,
        'data-mapping': mapping,
        'data-strict': '1',
        'data-reactions-enabled': '1',
        'data-emit-metadata': '0',
        'data-input-position': 'top',
        'data-theme': giscusTheme(),
        'data-lang': 'en',
      };
      for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
      container.appendChild(s);
    }

    function syncTheme() {
      const frame = document.querySelector('iframe.giscus-frame');
      if (frame && frame.contentWindow) {
        frame.contentWindow.postMessage(
          { giscus: { setConfig: { theme: giscusTheme() } } },
          'https://giscus.app'
        );
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadGiscus);
    } else {
      loadGiscus();
    }

    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>
