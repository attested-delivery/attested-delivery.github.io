---
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="nav">
  <div class="container nav__inner">
    <a href="#top" class="nav__logo" aria-label="attested-delivery home">
      {/* Inlined so fills are token-driven and adapt to light/dark themes. */}
      <svg
        viewBox="0 0 240 64"
        height="32"
        role="img"
        aria-label="attested-delivery"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g
          transform="translate(8 8)"
          fill="none"
          stroke="var(--color-accent-base)"
          stroke-width="3"
          stroke-linejoin="round"
          stroke-linecap="round"
        >
          <path d="M24 2 L43 13 L43 35 L24 46 L9 37.5"></path>
          <path d="M5 35 L5 13 L24 2"></path>
          <path d="M9 37.5 L5 35" stroke="var(--color-threat-base)" stroke-width="3"></path>
          <path d="M15 24 L21 31 L34 16" stroke-width="4"></path>
        </g>
        <text
          x="64"
          y="33"
          font-family="var(--type-fontFamily-mono)"
          font-size="18"
          font-weight="700"
          letter-spacing="-0.01em"
          fill="var(--color-text-primary)">attested</text
        >
        <text
          x="64"
          y="52"
          font-family="var(--type-fontFamily-mono)"
          font-size="18"
          font-weight="400"
          letter-spacing="-0.01em"
          fill="var(--color-accent-base)">delivery</text
        >
      </svg>
    </a>
    <div class="nav__links">
      <a href="#how">How it works</a>
      <a href="#quickstart">Quickstart</a>
      <a href="#community">Community</a>
      <a href="https://github.com/orgs/attested-delivery/discussions">Discussions</a>
      <a href="/docs/" class="nav__cta">Docs &rarr;</a>
      <a
        href="https://github.com/attested-delivery"
        class="nav__icon"
        aria-label="attested-delivery on GitHub"
        rel="noopener"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
