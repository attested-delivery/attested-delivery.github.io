---
import { tokensCss } from '../lib/tokens.js';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'attested-delivery — the digest is the release',
  description = 'Signed, SLSA-attested, fail-closed-verified releases on GitHub-native tooling. The thing you verified is the thing that runs.',
} = Astro.props;

// CSS custom properties generated from design-system/tokens.json at build time.
const rootVars = tokensCss();
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {
      /* Resolve the theme before paint to avoid a flash. Shares Starlight's
       `starlight-theme` localStorage key (auto = key absent), so a visitor's
       choice carries between this site and /docs in production. */
    }
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {
          /* localStorage unavailable — fall back to system preference */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <!-- Design tokens as CSS variables — single source of truth -->
    <style set:html={rootVars}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
