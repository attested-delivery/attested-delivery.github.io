{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "attested-delivery",
  "description": "Design tokens for the attested-delivery brand. Theme: \"trust under threat\" — a dark, near-black field (the hostile climate) with a single high-signal verified-green accent (the proof that something held). Threat-red and caution-amber exist only as semantic state colors, never as a second brand accent.",
  "color": {
    "comment": "Brand palette. `accent` (verified-green) is the ONLY brand accent. `threat`/`caution` are semantic state colors used sparingly. All hex values are sRGB.",
    "background": {
      "void": { "value": "#0A0D13", "comment": "Page base — the hostile climate" },
      "base": { "value": "#0E121B", "comment": "Primary surface background" },
      "elevated": { "value": "#151B27", "comment": "Cards, raised panels" },
      "overlay": { "value": "#1C2433", "comment": "Code blocks, inset wells" }
    },
    "border": {
      "subtle": { "value": "#222C3C", "comment": "Hairline dividers" },
      "default": { "value": "#2E3A4D", "comment": "Card and input borders" },
      "strong": { "value": "#3C4B63", "comment": "Focus rings, emphasis" }
    },
    "text": {
      "primary": { "value": "#E8EEF6", "comment": "Headings and body on dark" },
      "secondary": { "value": "#AEBCCF", "comment": "Supporting copy" },
      "muted": { "value": "#7C8AA0", "comment": "Captions, metadata" },
      "inverse": { "value": "#0A0D13", "comment": "Text on accent fills" }
    },
    "accent": {
      "comment": "Verified-green — the single high-signal brand accent. Means: this held; it was checked.",
      "base": { "value": "#36D399", "comment": "Primary accent — links, marks, CTAs" },
      "strong": { "value": "#1FB47C", "comment": "Hover / pressed accent" },
      "soft": { "value": "#0F2A22", "comment": "Accent-tinted surface fill" },
      "ring": { "value": "#36D39966", "comment": "Accent focus glow (40% alpha)" }
    },
    "threat": {
      "comment": "Semantic only — the climate, force-pushed tags, orphaned attestations. Never a brand accent.",
      "base": { "value": "#FF5C6C", "comment": "Danger / compromise" },
      "soft": { "value": "#2A1014", "comment": "Threat-tinted surface fill" }
    },
    "caution": {
      "base": { "value": "#F4B740", "comment": "Warning / drift / unpinned" },
      "soft": { "value": "#2A2210", "comment": "Caution-tinted surface fill" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "value": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
      },
      "mono": {
        "value": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", \"Fira Code\", Menlo, Consolas, monospace"
      }
    },
    "fontWeight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "semibold": { "value": "600" },
      "bold": { "value": "700" }
    },
    "lineHeight": {
      "tight": { "value": "1.15" },
      "snug": { "value": "1.3" },
      "normal": { "value": "1.6" },
      "relaxed": { "value": "1.75" }
    },
    "letterSpacing": {
      "tight": { "value": "-0.02em" },
      "normal": { "value": "0" },
      "wide": { "value": "0.08em" }
    },
    "fontSize": {
      "comment": "Modular scale, ratio 1.25 (major third), base 1rem = 16px",
      "xs": { "value": "0.75rem" },
      "sm": { "value": "0.875rem" },
      "base": { "value": "1rem" },
      "lg": { "value": "1.25rem" },
      "xl": { "value": "1.563rem" },
      "2xl": { "value": "1.953rem" },
      "3xl": { "value": "2.441rem" },
      "4xl": { "value": "3.052rem" },
      "5xl": { "value": "3.815rem" }
    }
  },
  "spacing": {
    "comment": "4px base unit. Used for padding, margin, and gap.",
    "0": { "value": "0" },
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4rem" },
    "9": { "value": "6rem" },
    "10": { "value": "8rem" }
  },
  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "16px" },
    "xl": { "value": "24px" },
    "full": { "value": "9999px" }
  },
  "shadow": {
    "sm": { "value": "0 1px 2px rgba(0,0,0,0.4)" },
    "md": { "value": "0 4px 16px rgba(0,0,0,0.45)" },
    "lg": { "value": "0 16px 48px rgba(0,0,0,0.55)" },
    "accent": { "value": "0 0 0 1px #36D39966, 0 8px 32px rgba(54,211,153,0.18)" }
  },
  "layout": {
    "maxWidth": { "value": "1120px" },
    "proseMaxWidth": { "value": "68ch" }
  },
  "light": {
    "comment": "Light-theme overrides, emitted under :root[data-theme='light']. Only the values that must flip for a light field are redefined; everything else inherits the dark/base tokens. The verified-green accent is darkened for AA contrast on white. Mirrors the structure of `color` and `shadow`.",
    "color": {
      "background": {
        "void": { "value": "#EEF2F8" },
        "base": { "value": "#F8FAFD" },
        "elevated": { "value": "#FFFFFF" },
        "overlay": { "value": "#EDF1F7" }
      },
      "border": {
        "subtle": { "value": "#E2E8F1" },
        "default": { "value": "#CFD8E5" },
        "strong": { "value": "#A9B6CB" }
      },
      "text": {
        "primary": { "value": "#0E121B" },
        "secondary": { "value": "#3A465B" },
        "muted": { "value": "#5A6678" },
        "inverse": { "value": "#06140E" }
      },
      "accent": {
        "base": { "value": "#0F8A5C" },
        "strong": { "value": "#0B6E49" },
        "soft": { "value": "#E4F7EF" },
        "ring": { "value": "#0F8A5C40" }
      },
      "threat": {
        "base": { "value": "#C6303F" },
        "soft": { "value": "#FBE9EB" }
      },
      "caution": {
        "base": { "value": "#9A6B08" },
        "soft": { "value": "#FBF1D8" }
      }
    },
    "shadow": {
      "sm": { "value": "0 1px 2px rgba(16,24,40,0.08)" },
      "md": { "value": "0 4px 16px rgba(16,24,40,0.10)" },
      "lg": { "value": "0 16px 48px rgba(16,24,40,0.14)" },
      "accent": { "value": "0 0 0 1px #0F8A5C55, 0 8px 32px rgba(15,138,92,0.16)" }
    }
  }
}
