{
  // Marketing/brand prose: allow long lines and let Prettier own wrapping.
  "config": {
    "default": true,
    "MD013": false, // line length — prose is reflowed by Prettier
    "MD033": false, // inline HTML — used intentionally in README badges/markup
    "MD041": false // first line need not be a top-level heading
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "dist", ".astro"]
}
